{% comment %}
摘要邮件的可复用构件。全部用 macro ... export 声明，由 digest_* 模板 import 使用。

两条约束（均已实测）：
1. import 必须写在 block 内部。子模板根级节点在 extends 继承链中不会被执行，
   宏调用会静默渲染为空字符串且不报错。
2. 宏调用兄弟宏时，是在「导入方」的上下文里查找的。因此这里不做宏间调用，
   徽章标记直接内联，避免调用方漏导入而静默失效。

tone 取值：neutral | success | danger | warning，由 Go 渲染层给出，
模板不解析业务状态字符串。用户内容一律自动转义，禁止 safe 过滤器。

样式取舍：mso-* 与 border-collapse 统一放在 layouts/main.django 的 <style> 里
（Outlook 不剥离 style，逐表格内联只会撑大体积）；颜色、间距等 QQ 邮箱需要的
部分才内联。统计胶囊用 span 而非 table——Word 引擎忽略 table 上的
display:inline-block，会让胶囊逐行堆叠。
{% endcomment %}

{% macro metric_pill(label, count, tone="neutral") export %}
<span style="display:inline-block;vertical-align:middle;margin:0 6px 6px 0;padding:4px 10px;border-radius:12px;font-size:12px;line-height:1.4;{% if tone == "success" %}background-color:#def7ec;color:#03543f;border:1px solid #bcf0da;{% elif tone == "danger" %}background-color:#fde8e8;color:#9b1c1c;border:1px solid #fbd5d5;{% elif tone == "warning" %}background-color:#fef3c7;color:#92400e;border:1px solid #fde68a;{% else %}background-color:#edf2f7;color:#4a5568;border:1px solid #e2e8f0;{% endif %}"><b style="font-size:13px;">{{ count }}</b> {{ label }}</span>
{% endmacro %}

{% macro section_header(title, count=0, tone="neutral") export %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin:24px 0 10px 0;">
<tr><td role="heading" aria-level="2" style="border-left:4px solid {% if tone == "danger" %}#e53e3e{% elif tone == "success" %}#48bb78{% elif tone == "warning" %}#ed8936{% else %}#4a5568{% endif %};padding:2px 0 2px 10px;font-size:15px;font-weight:bold;color:#2d3748;line-height:1.4;">{{ title }}{% if count > 0 %} <span style="font-size:13px;font-weight:normal;color:#718096;">（{{ count }}）</span>{% endif %}</td></tr>
</table>
{% endmacro %}

{% macro contributor_row(item) export %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom:10px;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:4px;">
<tr><td style="padding:12px 14px;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
<tr valign="top">
<td align="left" style="font-size:12px;color:#718096;line-height:1.4;">{% if item.combined_label or item.status_label %}<span style="display:inline-block;padding:2px 6px;border-radius:3px;font-size:11px;{% if item.status_tone == "success" %}background-color:#def7ec;color:#03543f;border:1px solid #bcf0da;{% elif item.status_tone == "danger" %}background-color:#fde8e8;color:#9b1c1c;border:1px solid #fbd5d5;{% elif item.status_tone == "warning" %}background-color:#fef3c7;color:#92400e;border:1px solid #fde68a;{% else %}background-color:#edf2f7;color:#4a5568;border:1px solid #e2e8f0;{% endif %}">{% if item.combined_label %}{{ item.combined_label }}{% else %}{{ item.status_label }}{% endif %}</span> {% endif %}{% if item.type_label %}<span style="color:#718096;font-size:12px;">{{ item.type_label }}</span>{% endif %}</td>
<td align="right" style="font-size:11px;color:#718096;line-height:1.4;white-space:nowrap;padding-left:8px;">{{ item.occurred_at }}</td>
</tr>
<tr><td colspan="2" style="padding-top:8px;font-size:14px;color:#2d3748;line-height:1.6;word-break:break-word;overflow-wrap:break-word;">「{{ item.hitokoto }}」</td></tr>
<tr><td colspan="2" align="right" style="padding-top:4px;font-size:12px;color:#718096;line-height:1.4;word-break:break-word;overflow-wrap:break-word;">—— {{ item.from_who|default:"未填写" }}{% if item.from %}《{{ item.from }}》{% endif %}</td></tr>
</table>
</td></tr>
</table>
{% endmacro %}

{% macro reviewer_row(item) export %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom:10px;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:4px;">
<tr><td style="padding:12px 14px;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
<tr valign="top">
<td align="left" style="font-size:12px;color:#718096;line-height:1.4;"><span style="display:inline-block;padding:2px 6px;border-radius:3px;font-size:11px;font-weight:bold;background-color:#edf2f7;color:#4a5568;border:1px solid #cbd5e0;">#{{ item.poll_id }}</span>{% if item.status_label %} <span style="display:inline-block;padding:2px 6px;border-radius:3px;font-size:11px;{% if item.status_tone == "success" %}background-color:#def7ec;color:#03543f;border:1px solid #bcf0da;{% elif item.status_tone == "danger" %}background-color:#fde8e8;color:#9b1c1c;border:1px solid #fbd5d5;{% elif item.status_tone == "warning" %}background-color:#fef3c7;color:#92400e;border:1px solid #fde68a;{% else %}background-color:#edf2f7;color:#4a5568;border:1px solid #e2e8f0;{% endif %}">{{ item.status_label }}</span>{% endif %}{% if item.type_label %} <span style="color:#718096;font-size:12px;">{{ item.type_label }}</span>{% endif %}</td>
<td align="right" style="font-size:11px;color:#718096;line-height:1.4;white-space:nowrap;padding-left:8px;">{{ item.occurred_at }}</td>
</tr>
<tr><td colspan="2" style="padding-top:8px;font-size:14px;color:#2d3748;line-height:1.6;word-break:break-word;overflow-wrap:break-word;">「{{ item.hitokoto }}」</td></tr>
<tr><td colspan="2" style="padding-top:4px;font-size:12px;color:#718096;line-height:1.4;word-break:break-word;overflow-wrap:break-word;">提交者：{{ item.creator }}{% if item.method_label %}&nbsp;·&nbsp;您投了 <b>{{ item.method_label }}</b> {{ item.point }} 票{% endif %}</td></tr>
<tr><td colspan="2" align="right" style="padding-top:2px;font-size:12px;color:#718096;line-height:1.4;word-break:break-word;overflow-wrap:break-word;">—— {{ item.from_who|default:"未填写" }}{% if item.from %}《{{ item.from }}》{% endif %}</td></tr>
</table>
</td></tr>
</table>
{% endmacro %}

{% macro overflow_notice(count, url="") export %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin:12px 0;">
<tr><td align="center" style="padding:10px 14px;background-color:#edf2f7;border-radius:4px;font-size:13px;color:#718096;line-height:1.4;">另有 <b>{{ count }}</b> 条未在邮件中展开{% if url %}，<a href="{{ url }}" target="_blank" rel="noopener" style="color:#3869d4;text-decoration:underline;">前往查看完整列表</a>{% endif %}。</td></tr>
</table>
{% endmacro %}
